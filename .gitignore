# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings (permissions, personal overrides)
.claude/settings.local.json

# material de referência/design bruto — não é usado em tempo de execução
# (o que é usado já foi copiado pra /public); fora do repo pra não inchar o
# histórico do git com ~57MB de PDFs/exports que não fazem parte do site.
/ASSETS SITE/
/REFERENCIAS/
/BRANDBOOK ANORA OFICIAL.pdf
/SITE - LIBERADO - teste 2.pdf
